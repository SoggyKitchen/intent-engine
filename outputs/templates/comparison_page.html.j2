<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ meta_description }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ canonical_url }}">
<style>
  :root { --primary: #1a1a2e; --accent: #e94560; --bg: #f8f9fa; --text: #333; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         background: var(--bg); color: var(--text); line-height: 1.6; }
  .container { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
  h1 { font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem; }
  .subtitle { color: #666; margin-bottom: 2rem; font-size: 1.1rem; }
  .tldr-box { background: #fff3cd; border-left: 4px solid #ffc107;
              padding: 1rem 1.5rem; margin: 1.5rem 0; border-radius: 4px; }
  .tldr-box strong { color: var(--primary); }
  table { width: 100%; border-collapse: collapse; margin: 2rem 0; background: #fff;
          box-shadow: 0 1px 4px rgba(0,0,0,.1); border-radius: 8px; overflow: hidden; }
  th { background: var(--primary); color: #fff; padding: 0.85rem 1rem; text-align: left; }
  td { padding: 0.75rem 1rem; border-bottom: 1px solid #eee; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #f5f5f5; }
  .winner-badge { background: #28a745; color: #fff; padding: 2px 8px;
                  border-radius: 12px; font-size: 0.75rem; margin-left: 6px; }
  .cta-section { background: var(--primary); color: #fff; padding: 2rem;
                 border-radius: 8px; margin: 2rem 0; text-align: center; }
  .cta-section h2 { margin-bottom: 0.75rem; }
  .cta-btn { display: inline-block; background: var(--accent); color: #fff;
             padding: 0.8rem 2rem; border-radius: 6px; text-decoration: none;
             font-weight: 600; margin-top: 0.75rem; }
  .section { margin: 2.5rem 0; }
  .section h2 { font-size: 1.4rem; color: var(--primary); margin-bottom: 1rem;
                border-bottom: 2px solid var(--accent); padding-bottom: 0.5rem; }
  .verdict-box { background: #d4edda; border-left: 4px solid #28a745;
                 padding: 1rem 1.5rem; border-radius: 4px; }
  .pros-cons { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0; }
  .pros { background: #d4edda; padding: 1rem; border-radius: 6px; }
  .cons { background: #f8d7da; padding: 1rem; border-radius: 6px; }
  .pros h4 { color: #155724; } .cons h4 { color: #721c24; }
  ul { padding-left: 1.2rem; } li { margin: 0.4rem 0; }
  .faq-item { margin: 1rem 0; padding: 1rem; background: #fff;
              border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.07); }
  .faq-item h3 { color: var(--primary); font-size: 1rem; margin-bottom: 0.5rem; }
  footer { text-align: center; color: #999; font-size: 0.85rem; margin-top: 3rem;
           padding-top: 2rem; border-top: 1px solid #eee; }
  @media(max-width:600px){ .pros-cons{grid-template-columns:1fr;} h1{font-size:1.5rem;} }
</style>
{% if schema_json %}<script type="application/ld+json">{{ schema_json }}</script>{% endif %}
</head>
<body>
<div class="container">
  <h1>{{ title }}</h1>
  <p class="subtitle">{{ subtitle }}</p>

  <div class="tldr-box">
    <strong>TL;DR:</strong> {{ tldr }}
  </div>

  <div class="section">
    <h2>Quick Comparison</h2>
    <table>
      <tr>
        <th>Feature</th>
        {% for tool in tools %}<th>{{ tool.name }}{% if tool.winner %}<span class="winner-badge">Best Pick</span>{% endif %}</th>{% endfor %}
      </tr>
      {% for feature in comparison_features %}
      <tr>
        <td><strong>{{ feature.name }}</strong></td>
        {% for val in feature.values %}<td>{{ val }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </table>
  </div>

  {% for tool in tools %}
  <div class="section">
    <h2>{{ tool.name }} — In Depth</h2>
    <p>{{ tool.description }}</p>
    <div class="pros-cons">
      <div class="pros"><h4>✓ Pros</h4><ul>{% for p in tool.pros %}<li>{{ p }}</li>{% endfor %}</ul></div>
      <div class="cons"><h4>✗ Cons</h4><ul>{% for c in tool.cons %}<li>{{ c }}</li>{% endfor %}</ul></div>
    </div>
    <p><strong>Pricing:</strong> {{ tool.pricing }}</p>
    {% if tool.affiliate_url %}
    <p><a href="{{ tool.affiliate_url }}" rel="sponsored noopener">Try {{ tool.name }} Free →</a></p>
    {% endif %}
  </div>
  {% endfor %}

  <div class="verdict-box">
    <strong>Our Verdict:</strong> {{ verdict }}
  </div>

  {% if cta_tool %}
  <div class="cta-section">
    <h2>Ready to get started?</h2>
    <p>{{ cta_text }}</p>
    <a class="cta-btn" href="{{ cta_url }}" rel="sponsored noopener">{{ cta_button }}</a>
  </div>
  {% endif %}

  <div class="section">
    <h2>Frequently Asked Questions</h2>
    {% for faq in faqs %}
    <div class="faq-item">
      <h3>{{ faq.question }}</h3>
      <p>{{ faq.answer }}</p>
    </div>
    {% endfor %}
  </div>

  <footer>
    <p>Last updated: {{ updated_date }} · This page contains affiliate links. We may earn a commission at no extra cost to you.</p>
  </footer>
</div>
</body>
</html>
