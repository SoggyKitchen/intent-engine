<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | SaaSpare</title>
<meta name="description" content="{{ meta_description }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ meta_description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ canonical_url }}">
<meta name="Impact-Site-Verification" content="630c59bd-7d94-4608-bf4d-7c9258a43362">
<meta name="Impact-Site-Verification" content="a1bb8518-4dc8-412a-80a9-fb1009113071">
{% if schema_json %}<script type="application/ld+json">{{ schema_json }}</script>{% endif %}
{% if ga_id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ ga_id }}');</script>
{% endif %}
<style>
/* ─── Reset & Base ──────────────────────────────────────────────────── */
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#1a1a2e;
  --primary-deep:#16213e;
  --accent:#e94560;
  --accent-hover:#c73652;
  --green:#28a745;
  --bg:#0d0d1a;
  --surface:rgba(255,255,255,.05);
  --border:rgba(255,255,255,.09);
  --text:#e0e1ea;
  --text-muted:rgba(255,255,255,.55);
  --text-dim:rgba(255,255,255,.35);
  --radius-sm:8px;
  --radius-md:12px;
  --radius-lg:16px;
  --radius-pill:100px;
  --shadow-accent:0 8px 24px rgba(233,69,96,.35);
  --shadow-green:0 6px 18px rgba(40,167,69,.38);
}
html{scroll-behavior:smooth}
body{
  font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.65;
  -webkit-font-smoothing:antialiased;
}

/* ─── Scrollbar ─────────────────────────────────────────────────────── */
::-webkit-scrollbar{width:6px;background:rgba(255,255,255,.03)}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:3px}

/* ─── Nav ───────────────────────────────────────────────────────────── */
nav{
  position:sticky;top:0;z-index:200;
  background:rgba(13,13,26,.88);
  -webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);
  border-bottom:1px solid rgba(255,255,255,.07);
  padding:.75rem 1.5rem;
  display:flex;align-items:center;gap:.5rem;
}
.nav-logo{display:flex;align-items:center;gap:8px;text-decoration:none;margin-right:auto}
.nav-logo-bars{display:flex;flex-direction:column;gap:3px}
.nav-logo-bars span{display:block;height:2.5px;background:var(--accent);border-radius:2px}
.nav-logo-bars span:nth-child(1){width:14px}
.nav-logo-bars span:nth-child(2){width:10px;opacity:.65}
.nav-logo-bars span:nth-child(3){width:14px;opacity:.35}
.nav-logo-text{font-size:1.05rem;font-weight:800;letter-spacing:-.3px;color:#fff}
.nav-logo-text em{color:var(--accent);font-style:normal}
.nav-divider{width:1px;height:16px;background:rgba(255,255,255,.1);margin:0 .25rem}
nav a.nav-link{
  color:rgba(255,255,255,.55);text-decoration:none;font-size:.84rem;
  padding:.38rem .75rem;border-radius:var(--radius-sm);transition:all .18s;font-weight:500;
}
nav a.nav-link:hover{color:#fff;background:rgba(255,255,255,.07)}
.nav-cta{
  background:linear-gradient(135deg,var(--accent),var(--accent-hover));
  color:#fff!important;padding:.42rem 1.1rem!important;border-radius:var(--radius-pill)!important;
  font-weight:700!important;font-size:.82rem!important;letter-spacing:.1px;
  box-shadow:0 3px 12px rgba(233,69,96,.35);text-decoration:none;margin-left:.5rem;
}

/* ─── Hero / Page header ─────────────────────────────────────────────── */
.page-hero{
  background:linear-gradient(160deg,#16213e 0%,#0f3460 50%,#1a0a1e 100%);
  padding:3.25rem 1.5rem 2.75rem;position:relative;overflow:hidden;
}
.page-hero::before{
  content:'';position:absolute;top:-80px;left:50%;transform:translateX(-50%);
  width:600px;height:320px;
  background:radial-gradient(ellipse,rgba(233,69,96,.12) 0%,transparent 70%);
  pointer-events:none;
}
.hero-inner{max-width:860px;margin:0 auto;position:relative}
.breadcrumb{font-size:.78rem;color:var(--text-dim);margin-bottom:1.25rem;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.breadcrumb a{color:var(--text-dim);text-decoration:none;transition:color .18s}
.breadcrumb a:hover{color:rgba(255,255,255,.65)}
.page-title{font-size:clamp(1.75rem,5vw,2.5rem);font-weight:800;color:#fff;letter-spacing:-.5px;line-height:1.15;margin-bottom:.75rem}
.page-title .year{color:rgba(255,255,255,.3);font-weight:400;font-size:65%}
.verified-badge{
  display:inline-flex;align-items:center;gap:5px;
  background:rgba(40,167,69,.18);border:1px solid rgba(40,167,69,.35);
  color:#7ecf8a;padding:4px 13px;border-radius:var(--radius-pill);
  font-size:.74rem;font-weight:700;letter-spacing:.3px;
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  margin-left:12px;vertical-align:middle;
}
.page-subtitle{color:var(--text-muted);font-size:.98rem;max-width:560px;line-height:1.7;margin-bottom:1.75rem}

/* ─── Trust chips ────────────────────────────────────────────────────── */
.trust-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:0}
.trust-chip{
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  color:rgba(255,255,255,.6);padding:5px 14px;border-radius:var(--radius-pill);
  font-size:.77rem;font-weight:500;
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
}
.trust-chip::before{content:'✓ ';color:var(--green)}

/* ─── Container ─────────────────────────────────────────────────────── */
.container{max-width:880px;margin:0 auto;padding:0 1.25rem 4rem}

/* ─── TL;DR box ─────────────────────────────────────────────────────── */
.tldr-box{
  background:linear-gradient(135deg,rgba(255,193,7,.09),rgba(255,193,7,.04));
  border:1px solid rgba(255,193,7,.22);border-radius:var(--radius-md);
  padding:1.1rem 1.4rem;margin:1.5rem 0;display:flex;gap:12px;align-items:flex-start;
}
.tldr-icon{font-size:1.1rem;flex-shrink:0;margin-top:1px}
.tldr-label{font-size:.72rem;font-weight:800;color:rgba(255,193,7,.85);letter-spacing:.6px;text-transform:uppercase;display:block;margin-bottom:4px}
.tldr-text{color:rgba(255,255,255,.72);font-size:.93rem;line-height:1.65}

/* ─── Jump links ─────────────────────────────────────────────────────── */
.jump-links{display:flex;gap:6px;flex-wrap:wrap;margin:1.25rem 0 1.75rem}
.jump-link{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  color:rgba(255,255,255,.6);text-decoration:none;padding:5px 14px;
  border-radius:var(--radius-pill);font-size:.79rem;font-weight:500;
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);transition:all .18s;
}
.jump-link:hover{background:rgba(255,255,255,.11);color:#fff}

/* ─── Section heading ───────────────────────────────────────────────── */
.section-heading{
  font-size:1.15rem;font-weight:800;color:rgba(255,255,255,.9);
  margin:2rem 0 1rem;letter-spacing:-.2px;display:flex;align-items:center;gap:10px;
}
.section-heading::before{
  content:'';display:block;width:3px;height:18px;flex-shrink:0;
  background:linear-gradient(var(--accent),var(--accent-hover));border-radius:2px;
}

/* ─── Comparison table ──────────────────────────────────────────────── */
.table-section{margin:2rem 0}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--radius-lg);border:1px solid var(--border)}
.table-wrap::-webkit-scrollbar{height:4px}
.table-wrap::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:2px}
table{width:100%;border-collapse:collapse;background:transparent;min-width:480px}
thead th{
  background:rgba(13,13,26,.92);
  -webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
  padding:.85rem 1.1rem;text-align:left;font-size:.8rem;font-weight:700;
  letter-spacing:.45px;text-transform:uppercase;color:rgba(255,255,255,.65);
  border-bottom:1px solid var(--border);position:sticky;top:60px;
}
tbody tr{border-bottom:1px solid rgba(255,255,255,.05);transition:background .15s}
tbody tr:last-child{border-bottom:none}
tbody tr:nth-child(even){background:rgba(255,255,255,.02)}
tbody tr:hover{background:rgba(255,255,255,.05)}
td{padding:.75rem 1.1rem;font-size:.87rem;color:rgba(255,255,255,.75)}
td:first-child{font-weight:600;color:rgba(255,255,255,.5);font-size:.8rem;letter-spacing:.2px}
.winner-col{color:rgba(255,255,255,.92)!important}
.winner-badge{
  display:inline-block;
  background:linear-gradient(135deg,var(--green),#1e8c38);color:#fff;
  padding:2px 9px;border-radius:var(--radius-pill);
  font-size:.68rem;margin-left:8px;font-weight:700;letter-spacing:.3px;
  box-shadow:0 2px 7px rgba(40,167,69,.4);vertical-align:middle;
}
.star-text{color:#ffc107;letter-spacing:1px}

/* ─── Score bar ─────────────────────────────────────────────────────── */
.score-wrap{margin-bottom:7px}
.score-row{display:flex;justify-content:space-between;font-size:.74rem;color:rgba(255,255,255,.45);margin-bottom:3px}
.score-val{font-weight:700;color:rgba(255,255,255,.75)}
.score-track{background:rgba(255,255,255,.08);border-radius:100px;height:6px;overflow:hidden}
.score-fill{height:6px;border-radius:100px}
.score-fill-winner{background:linear-gradient(90deg,var(--green),#34c85a)}
.score-fill-alt{background:linear-gradient(90deg,var(--accent),#f05671)}

/* ─── Star rating ────────────────────────────────────────────────────── */
.stars-full{color:#ffc107;letter-spacing:2px;font-size:1rem}
.stars-empty{color:rgba(255,255,255,.15);letter-spacing:2px;font-size:1rem}

/* ─── Primary CTA box ────────────────────────────────────────────────── */
.cta-box{
  background:linear-gradient(135deg,rgba(233,69,96,.18),rgba(199,54,82,.07));
  border:1px solid rgba(233,69,96,.3);border-radius:var(--radius-lg);
  padding:2rem 1.75rem;margin:2rem 0;
  display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;
  -webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
}
.cta-box-label{font-size:.72rem;font-weight:700;color:var(--accent);letter-spacing:.8px;text-transform:uppercase;margin-bottom:6px}
.cta-box-title{font-size:1.3rem;font-weight:800;color:#fff;letter-spacing:-.3px;margin-bottom:6px}
.cta-box-desc{color:var(--text-muted);font-size:.88rem;line-height:1.6}
.cta-btn{
  display:inline-block;
  background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff;
  padding:.85rem 2rem;border-radius:var(--radius-pill);text-decoration:none;
  font-weight:800;font-size:.92rem;white-space:nowrap;letter-spacing:.1px;
  box-shadow:var(--shadow-accent),inset 0 1px 0 rgba(255,255,255,.2);
  transition:opacity .18s;
}
.cta-btn:hover{opacity:.9}
.cta-btn-green{
  display:inline-block;
  background:linear-gradient(135deg,var(--green),#1e8c38);color:#fff;
  padding:.75rem 1.75rem;border-radius:var(--radius-pill);text-decoration:none;
  font-weight:800;font-size:.9rem;white-space:nowrap;
  box-shadow:var(--shadow-green),inset 0 1px 0 rgba(255,255,255,.2);
  transition:opacity .18s;
}
.cta-btn-alt{
  display:inline-block;
  background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff;
  padding:.75rem 1.75rem;border-radius:var(--radius-pill);text-decoration:none;
  font-weight:800;font-size:.9rem;white-space:nowrap;
  box-shadow:var(--shadow-accent),inset 0 1px 0 rgba(255,255,255,.2);
  transition:opacity .18s;
}
.cta-btn-alt:hover,.cta-btn-green:hover{opacity:.9}

/* ─── Tool card ─────────────────────────────────────────────────────── */
.tool-card{
  background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
  border:1px solid var(--border);border-radius:18px;overflow:hidden;margin:2rem 0;
  box-shadow:0 8px 32px rgba(0,0,0,.3);
}
.tool-card.winner{
  border-color:rgba(40,167,69,.28);
  box-shadow:0 0 0 1px rgba(40,167,69,.12),0 8px 32px rgba(40,167,69,.18);
}
.tool-card-header{
  padding:1.5rem 1.75rem;
  border-bottom:1px solid rgba(255,255,255,.07);
  display:flex;align-items:center;gap:1rem;flex-wrap:wrap;
}
.tool-card.winner .tool-card-header{
  background:linear-gradient(135deg,rgba(40,167,69,.14),rgba(30,140,56,.04));
}
.tool-name{font-size:1.4rem;font-weight:800;color:#fff;letter-spacing:-.4px}
.tool-score{display:flex;align-items:center;gap:10px;margin-top:5px;flex-wrap:wrap}
.score-num{font-size:.88rem;color:var(--text-muted);font-weight:600}
.tool-tagline{font-size:.8rem;color:rgba(255,255,255,.35);font-style:italic}
.tool-card-body{padding:1.5rem 1.75rem}
.tool-desc{color:rgba(255,255,255,.6);font-size:.92rem;line-height:1.7;margin-bottom:1.25rem}

/* Score breakdown panel */
.scores-panel{
  background:rgba(0,0,0,.22);border-radius:10px;padding:1rem 1.2rem;
  margin-bottom:1.25rem;border:1px solid rgba(255,255,255,.05);
}
.scores-panel-label{font-size:.72rem;font-weight:700;color:rgba(255,255,255,.3);letter-spacing:.8px;text-transform:uppercase;margin-bottom:10px}

/* Pros / cons */
.pros-cons{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.25rem}
.pros-box{background:rgba(40,167,69,.08);border:1px solid rgba(40,167,69,.2);border-radius:10px;padding:1rem}
.cons-box{background:rgba(233,69,96,.07);border:1px solid rgba(233,69,96,.18);border-radius:10px;padding:1rem}
.pc-label{font-size:.72rem;font-weight:800;letter-spacing:.6px;text-transform:uppercase;margin-bottom:8px}
.pros-box .pc-label{color:#7ecf8a}
.cons-box .pc-label{color:#f08090}
.pc-list{padding-left:1rem;margin:0;list-style:disc}
.pc-list li{font-size:.82rem;color:rgba(255,255,255,.68);margin-bottom:4px;line-height:1.5}

.pricing-text{font-size:.82rem;color:rgba(255,255,255,.45);line-height:1.6}
.pricing-text strong{color:rgba(255,255,255,.7);font-weight:700}

/* ─── Verdict box ────────────────────────────────────────────────────── */
.verdict-box{
  background:linear-gradient(135deg,rgba(40,167,69,.12),rgba(40,167,69,.04));
  border:1px solid rgba(40,167,69,.25);border-radius:var(--radius-md);
  padding:1.4rem 1.6rem;margin:2rem 0;
}
.verdict-label{font-size:.72rem;font-weight:800;color:#7ecf8a;letter-spacing:.8px;text-transform:uppercase;margin-bottom:8px}
.verdict-text{color:rgba(255,255,255,.8);line-height:1.75;font-size:.95rem;font-weight:500}

/* ─── FAQ ───────────────────────────────────────────────────────────── */
.faq-section{margin:2rem 0}
.faq-item{
  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
  border-radius:10px;margin-bottom:8px;overflow:hidden;
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
}
.faq-summary{
  padding:.95rem 1.1rem;font-weight:600;color:rgba(255,255,255,.8);
  font-size:.92rem;cursor:pointer;display:flex;justify-content:space-between;
  align-items:center;gap:12px;list-style:none;user-select:none;
}
.faq-summary::-webkit-details-marker{display:none}
.faq-summary::after{content:'▾';color:var(--accent);font-size:.8rem;flex-shrink:0;opacity:.8;transition:transform .2s}
details[open] .faq-summary::after{content:'▴'}
.faq-answer{padding:.25rem 1.1rem 1rem;font-size:.87rem;color:rgba(255,255,255,.5);line-height:1.75}

/* ─── Social share ───────────────────────────────────────────────────── */
.share-row{text-align:center;margin:1.75rem 0}
.share-label{color:rgba(255,255,255,.28);font-size:.8rem;margin-bottom:.75rem}
.share-btns{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.share-btn{
  display:inline-block;color:rgba(255,255,255,.7);padding:.45rem 1.1rem;
  border-radius:var(--radius-pill);text-decoration:none;font-size:.82rem;font-weight:600;
  border:1px solid rgba(255,255,255,.1);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  transition:all .18s;
}
.share-btn:hover{color:#fff;background:rgba(255,255,255,.08)}
.share-x{background:rgba(255,255,255,.07)}
.share-li{background:rgba(0,119,181,.18);border-color:rgba(0,119,181,.3)}
.share-rd{background:rgba(255,69,0,.18);border-color:rgba(255,69,0,.3)}

/* ─── Email capture ─────────────────────────────────────────────────── */
.email-box{
  background:linear-gradient(135deg,rgba(255,255,255,.07),rgba(255,255,255,.03));
  border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-lg);
  padding:2rem 1.75rem;margin:2rem 0;text-align:center;
  -webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);
}
.email-box h3{font-size:1.1rem;font-weight:800;color:#fff;margin-bottom:.4rem;letter-spacing:-.2px}
.email-box p{color:rgba(255,255,255,.4);font-size:.88rem;margin-bottom:1.25rem;line-height:1.6}
.email-row{display:flex;gap:8px;max-width:380px;margin:0 auto;flex-wrap:wrap;justify-content:center}
.email-input{
  flex:1;min-width:180px;padding:.7rem 1rem;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
  border-radius:var(--radius-pill);font-size:.9rem;color:#fff;
  outline:none;font-family:inherit;transition:border .18s;
}
.email-input:focus{border-color:rgba(255,255,255,.25)}
.email-input::placeholder{color:rgba(255,255,255,.3)}
.email-btn{
  background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff;
  border:none;padding:.7rem 1.4rem;border-radius:var(--radius-pill);
  cursor:pointer;font-weight:700;font-family:inherit;font-size:.88rem;
  box-shadow:0 4px 14px rgba(233,69,96,.38);transition:opacity .18s;
}
.email-btn:hover{opacity:.9}
.email-note{font-size:.73rem;color:rgba(255,255,255,.2);margin-top:.75rem}
.email-success{color:#7ecf8a;font-weight:700;padding:.5rem 0}

/* ─── Related pills ─────────────────────────────────────────────────── */
.related-box{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);
  border-radius:var(--radius-md);padding:1.25rem 1.5rem;margin:1.5rem 0;
}
.related-label{font-size:.72rem;font-weight:700;color:rgba(255,255,255,.3);letter-spacing:.8px;text-transform:uppercase;margin-bottom:10px}
.related-links{display:flex;flex-wrap:wrap;gap:7px}
.related-link{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);
  padding:5px 13px;border-radius:var(--radius-pill);font-size:.8rem;
  text-decoration:none;color:rgba(255,255,255,.6);transition:all .18s;font-weight:500;
}
.related-link:hover{background:rgba(255,255,255,.12);color:#fff}

/* ─── Footer ─────────────────────────────────────────────────────────── */
footer{
  text-align:center;color:rgba(255,255,255,.25);font-size:.78rem;
  margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,.07);line-height:2;
}
footer a{color:rgba(255,255,255,.3);text-decoration:none}
footer a:hover{color:rgba(255,255,255,.6)}

/* ─── Mobile ─────────────────────────────────────────────────────────── */
@media(max-width:620px){
  .page-title{font-size:1.6rem}
  nav a.nav-link{display:none}
  .pros-cons{grid-template-columns:1fr}
  .cta-box{flex-direction:column;text-align:center}
  .tool-card-header{flex-direction:column;align-items:flex-start}
  .email-row{flex-direction:column}
  .email-input,.email-btn{width:100%}
}
</style>
</head>
<body>

<!-- ─── Navigation ─────────────────────────────────────────────────────── -->
<nav>
  <a href="{{ site_domain | default('https://saaspare.org') }}" class="nav-logo">
    <div class="nav-logo-bars"><span></span><span></span><span></span></div>
    <div class="nav-logo-text">Saas<em>Spare</em></div>
  </a>
  <div class="nav-divider"></div>
  <a href="{{ site_domain | default('https://saaspare.org') }}/pages/" class="nav-link">All Comparisons</a>
  <a href="{{ site_domain | default('https://saaspare.org') }}/about.html" class="nav-link">About</a>
  <a href="{{ site_domain | default('https://saaspare.org') }}/pages/saas-roi-calculator.html" class="nav-cta">ROI Calculator →</a>
</nav>

<!-- ─── Page hero ──────────────────────────────────────────────────────── -->
<div class="page-hero">
  <div class="hero-inner">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="{{ site_domain | default('https://saaspare.org') }}">Home</a>
      <span aria-hidden="true">›</span>
      <a href="{{ site_domain | default('https://saaspare.org') }}/pages/">Comparisons</a>
      <span aria-hidden="true">›</span>
      <span>{{ title }}</span>
    </nav>

    <h1 class="page-title">
      {{ title }}
      <span class="verified-badge">✓ Verified {{ updated_date }}</span>
    </h1>
    <p class="page-subtitle">{{ subtitle }}</p>

    <div class="trust-chips">
      <span class="trust-chip">Unbiased research</span>
      <span class="trust-chip">Real buyer data</span>
      <span class="trust-chip">No vendor sponsorship</span>
      <span class="trust-chip">Free to read</span>
    </div>
  </div>
</div>

<!-- ─── Main content ───────────────────────────────────────────────────── -->
<div class="container">

  <!-- TL;DR -->
  <div class="tldr-box">
    <span class="tldr-icon">⚡</span>
    <div>
      <span class="tldr-label">TL;DR</span>
      <span class="tldr-text">{{ tldr }}</span>
    </div>
  </div>

  <!-- Jump links -->
  <div class="jump-links" aria-label="Jump to section">
    <a class="jump-link" href="#compare">Quick Compare</a>
    {% for tool in tools %}
    <a class="jump-link" href="#tool-{{ loop.index }}">{{ tool.name }}</a>
    {% endfor %}
    <a class="jump-link" href="#verdict">Verdict</a>
    <a class="jump-link" href="#faq">FAQs</a>
  </div>

  <!-- ── Comparison table ─────────────────────────────────────────────── -->
  <div class="table-section" id="compare">
    <h2 class="section-heading">Quick Comparison</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:34%">Feature</th>
            {% for tool in tools %}
            <th>
              {{ tool.name }}
              {% if tool.winner %}<span class="winner-badge">Best Pick</span>{% endif %}
            </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for feature in comparison_features %}
          <tr>
            <td>{{ feature.name }}</td>
            {% for val in feature['values'] %}
            <td {% if tools[loop.index0].winner %}class="winner-col"{% endif %}>
              {% if '★' in val|string %}
                <span class="star-text">{{ val }}</span>
              {% else %}
                {{ val }}
              {% endif %}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- ── Primary CTA ────────────────────────────────────────────────────── -->
  {% if cta_url %}
  <div class="cta-box">
    <div style="flex:1;min-width:220px">
      <div class="cta-box-label">Our Top Pick</div>
      <div class="cta-box-title">{{ cta_text }}</div>
      <p class="cta-box-desc">Start your free trial today — most tools offer 14–30 days free, no credit card required.</p>
    </div>
    <a href="{{ cta_url }}" class="cta-btn" rel="sponsored noopener" target="_blank">{{ cta_button }}</a>
  </div>
  {% endif %}

  <!-- ── Per-tool review cards ──────────────────────────────────────────── -->
  {% for tool in tools %}
  <article class="tool-card {% if tool.winner %}winner{% endif %}" id="tool-{{ loop.index }}">
    <div class="tool-card-header">
      {% if tool.logo_url %}
      <div style="width:52px;height:52px;border-radius:12px;overflow:hidden;background:{{ tool.logo_bg | default('#fff') }};flex-shrink:0;box-shadow:0 2px 12px rgba(0,0,0,.3)">
        <img src="{{ tool.logo_url }}" alt="{{ tool.name }} logo" style="width:100%;height:100%;object-fit:cover">
      </div>
      {% endif %}
      <div style="flex:1;min-width:0">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:6px">
          <span class="tool-name">{{ tool.name }}</span>
          {% if tool.winner %}
          <span class="winner-badge" style="font-size:.72rem;padding:3px 12px">✓ Best Pick</span>
          {% endif %}
        </div>
        <div class="tool-score">
          {% if tool.score %}
            {% set fs = tool.score | float %}
            {% set full = fs | int %}
            {% set half = ((fs - full) >= 0.3 and (fs - full) < 0.8) %}
            {% set empty = 5 - full - (1 if half else 0) %}
            <span class="stars-full">{{ '★' * full }}</span>
            {% if half %}<span class="stars-full" style="opacity:.5">★</span>{% endif %}
            <span class="stars-empty">{{ '★' * empty }}</span>
            <span class="score-num">{{ tool.score }} / 5</span>
          {% else %}
            <span class="stars-full">★★★★</span><span class="stars-empty">★</span>
            <span class="score-num">/ 5</span>
          {% endif %}
        </div>
      </div>
      {% if tool.score %}
      <div style="flex-shrink:0;position:relative;width:52px;height:52px">
        {% set ring_pct = (tool.score | float / 5 * 113.1) | round(1) %}
        <svg width="52" height="52" viewBox="0 0 52 52" style="transform:rotate(-90deg)">
          <circle cx="26" cy="26" r="18" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="3.5"/>
          <circle cx="26" cy="26" r="18" fill="none" stroke="#ffc107" stroke-width="3.5"
            stroke-dasharray="{{ ring_pct }} 113.1" stroke-linecap="round"/>
        </svg>
        <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.8rem;color:#fff">{{ tool.score }}</div>
      </div>
      {% endif %}
      {% if tool.affiliate_url %}
      <a href="{{ tool.affiliate_url }}" rel="sponsored noopener" target="_blank"
         class="{% if tool.winner %}cta-btn-green{% else %}cta-btn-alt{% endif %}">
        Try {{ tool.name }} Free →
      </a>
      {% endif %}
    </div>

    <div class="tool-card-body">
      <p class="tool-desc">{{ tool.description }}</p>

      <!-- Pros / Cons -->
      <div class="pros-cons">
        <div class="pros-box">
          <div class="pc-label">Pros</div>
          <ul class="pc-list">
            {% for p in tool.pros %}<li>{{ p }}</li>{% endfor %}
          </ul>
        </div>
        <div class="cons-box">
          <div class="pc-label">Cons</div>
          <ul class="pc-list">
            {% for c in tool.cons %}<li>{{ c }}</li>{% endfor %}
          </ul>
        </div>
      </div>

      <p class="pricing-text"><strong>Pricing: </strong>{{ tool.pricing }}</p>
    </div>
  </article>
  {% endfor %}

  <!-- ── Verdict ────────────────────────────────────────────────────────── -->
  <div class="verdict-box" id="verdict">
    <div class="verdict-label">Our Verdict</div>
    <p class="verdict-text">{{ verdict }}</p>
  </div>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section class="faq-section" id="faq">
    <h2 class="section-heading">Frequently Asked Questions</h2>
    {% for faq in faqs %}
    <details class="faq-item" {% if loop.first %}open{% endif %}>
      <summary class="faq-summary">{{ faq.question }}</summary>
      <div class="faq-answer">{{ faq.answer }}</div>
    </details>
    {% endfor %}
  </section>

  <!-- ── Social share ───────────────────────────────────────────────────── -->
  <div class="share-row">
    <p class="share-label">Found this helpful? Share it:</p>
    <div class="share-btns">
      <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ canonical_url | urlencode }}"
         target="_blank" rel="noopener" class="share-btn share-x">𝕏 Share</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ canonical_url | urlencode }}"
         target="_blank" rel="noopener" class="share-btn share-li">LinkedIn</a>
      <a href="https://www.reddit.com/submit?url={{ canonical_url | urlencode }}&title={{ title | urlencode }}"
         target="_blank" rel="noopener" class="share-btn share-rd">Reddit</a>
    </div>
  </div>

  <!-- ── Email capture ──────────────────────────────────────────────────── -->
  <div class="email-box">
    <h3>Get the Weekly SaaS Deal Digest</h3>
    <p>Free trials, discounts and new comparisons — straight to your inbox every Friday.</p>
    <form action="https://formsubmit.co/smithelly30121@gmail.com" method="POST"
          class="email-row" id="sub-form">
      <input type="email" name="email" placeholder="your@email.com" required class="email-input">
      <input type="hidden" name="_subject" value="New SaaSpare subscriber">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="https://saaspare.org/pages/thanks.html">
      <button type="submit" class="email-btn">Subscribe Free</button>
    </form>
    <p class="email-note">No spam. Unsubscribe anytime.</p>
  </div>

  <!-- ── Related comparisons ────────────────────────────────────────────── -->
  {% if related_pages %}
  <div class="related-box">
    <div class="related-label">Related Comparisons</div>
    <div class="related-links">
      {% for rp in related_pages %}
      <a href="{{ rp.url }}" class="related-link">{{ rp.title }}</a>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- ── Bottom CTA ────────────────────────────────────────────────────── -->
  {% if cta_url %}
  <div class="cta-box" style="margin-top:2rem">
    <div style="flex:1;min-width:220px">
      <div class="cta-box-label">Ready to choose?</div>
      <div class="cta-box-title">Start your free trial today</div>
      <p class="cta-box-desc">Most tools offer 14–30 days free, no credit card required.</p>
    </div>
    <a href="{{ cta_url }}" class="cta-btn" rel="sponsored noopener" target="_blank">{{ cta_button }}</a>
  </div>
  {% endif %}

  <!-- ── Footer ─────────────────────────────────────────────────────────── -->
  <footer>
    <p>
      Last verified: {{ updated_date }} &nbsp;·&nbsp;
      <a href="{{ site_domain | default('https://saaspare.org') }}/about.html">About</a> &nbsp;·&nbsp;
      <a href="{{ site_domain | default('https://saaspare.org') }}/privacy.html">Privacy Policy</a> &nbsp;·&nbsp;
      <a href="{{ site_domain | default('https://saaspare.org') }}/contact.html">Contact</a>
    </p>
    <p style="margin-top:4px">This page contains affiliate links. We may earn a commission at no extra cost to you.</p>
  </footer>

</div><!-- /container -->

<script>
(function(){
  // FAQ: first item open by default on desktop, all closed on mobile
  if(window.innerWidth < 640){
    document.querySelectorAll('.faq-item').forEach(function(d){d.removeAttribute('open');});
  }

  // Email form — inline success message
  var sf=document.getElementById('sub-form');
  if(sf){
    sf.addEventListener('submit',function(e){
      setTimeout(function(){
        sf.innerHTML='<p class="email-success">✓ You\'re in! Check your inbox Friday.</p>';
      },200);
    });
  }

  // Scroll-spy CTA button: hide when user scrolls past affordance zone
  var cta_primary = document.querySelector('[data-cta="primary"]');
  var comparison_section = document.querySelector('.comparison-features');
  if(cta_primary && comparison_section){
    window.addEventListener('scroll', function(){
      var rect = comparison_section.getBoundingClientRect();
      cta_primary.style.display = rect.top < window.innerHeight ? 'none' : 'block';
    });
  }
})();
</script>

</body>
</html>
