# LLM providers (all free tiers)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
# OpenRouter: free tier works with no credit. Router auto-rotates through
# _OPENROUTER_FREE_MODELS (nemotron-120b, llama-70b, gemma-31b, hermes-405b,
# nemotron-nano-30b, llama-3b, owl-alpha). Set OPENROUTER_MODEL to pin one.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=
CEREBRAS_API_KEY=csk-...
CEREBRAS_API_KEY_2=csk-...
CEREBRAS_API_KEY_3=csk-...
CEREBRAS_API_KEY_4=csk-...
CEREBRAS_API_KEY_5=csk-...
CEREBRAS_API_KEY_6=csk-...
CEREBRAS_API_KEYS=csk_primary,csk_backup

# Data sources
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=IntentEngine/1.0 (contact: your@email.com)
GITHUB_TOKEN=ghp_...
STACKEXCHANGE_KEY=...

# Publishing
GUMROAD_ACCESS_TOKEN=...
CF_PAGES_REPO=https://github.com/YOU/intent-site.git
CF_PAGES_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...

# Affiliate
AMAZON_ASSOCIATE_TAG=yourtag-22

# Monitoring
HEALTHCHECKS_URL=https://hc-ping.com/...

# DB (SQLite path, auto-created)
DB_PATH=data/intent.db

# Behaviour
# Options: shadow | affiliate_only | full
MONETIZATION_MODE=affiliate_only
DRY_RUN=false
LOG_LEVEL=INFO
PROGRAMMATIC_ESTIMATED_TOKENS=2800
PROGRAMMATIC_MAX_OUTPUT_TOKENS=2200
