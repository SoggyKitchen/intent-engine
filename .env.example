# ── Data sources ─────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=IntentEngine/1.0 (contact: your@email.com)
GITHUB_TOKEN=ghp_...
