    "criteria": [
      {
        "key": "published_pricing",
        "label": "Publishes a real price",
        "test": "Every tier shows a number instead of a contact-sales form."
      },
      {
        "key": "no_setup_fee",
        "label": "No mandatory setup fee",
        "test": "No required one-time onboarding or implementation charge."
      },
      {
        "key": "single_seat",
        "label": "Will sell you one seat",
        "test": "No minimum seat count standing between you and the advertised price."
      },
      {
        "key": "monthly_billing",
        "label": "Lets you pay monthly",
        "test": "Paid tiers can be bought month to month, not annual commitment only."
      },
      {
        "key": "free_tier",
        "label": "Has a free tier",
        "test": "A genuinely free plan you can stay on, not just a countdown trial."
      },
      {
        "key": "trial_no_card",
        "label": "Trial without a card",
        "test": "You can try it without handing over card details first."
      },
      {
        "key": "fair_annual_gap",
        "label": "Monthly billing isn't punished",
        "test": "The premium for paying monthly instead of yearly stays under 25%."
      },
      {
        "key": "seats_at_list",
        "label": "Extra seats at list price",
        "test": "Adding a colleague costs the advertised per-seat price, with no surcharge."
      },
      {
        "key": "price_is_the_bill",
        "label": "The price is the whole bill",
        "test": "No usage or transaction charges metered on top of the published plan price."
      },
      {
        "key": "no_intro_cliff",
        "label": "No intro-price cliff",
        "test": "The advertised entry price is the real one, not a promotion that expires."
      }
    ]
  },
